# Supabase client configuration (client-safe values only).
# Copy this file to `.env.local` and fill in your project's values.
#
# SECURITY: never place the service-role key or the database password here or
# anywhere in the client bundle. Only the public anon key belongs client-side.

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
